# Google Sheets 連携（未設定の場合はローカルJSON .data/db.json にサンプルデータで動作）
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 改行は \n で記述可
GOOGLE_PRIVATE_KEY=
# もしくはサービスアカウントのキーJSONを1行で
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Google ログイン（3つとも設定すると自動で google モードになる）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# セッション署名用の32文字以上のランダム文字列（例: openssl rand -base64 48）
AUTH_SECRET=
# 公開URL（リダイレクトURIの組み立てに使用。例: https://pl.example.com）
APP_URL=
# 会社ドメインのアカウントに限定する場合（例: gooner.space）
AUTH_ALLOWED_DOMAIN=

# 認証モードを明示する場合: google / dev（視点切替・開発用） / locked（誰もログイン不可）
# 未指定時: Google の設定があれば google、無ければ開発環境は dev、本番は locked
# AUTH_MODE=

# 「今日」の日付を固定したい場合（デモ用）
# APP_TODAY=2026-09-23
