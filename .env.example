# Google Sheets 連携（未設定の場合はローカルJSON .data/db.json にサンプルデータで動作）
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 改行は \n で記述可
GOOGLE_PRIVATE_KEY=
# もしくはサービスアカウントのキーJSONを1行で
# GOOGLE_SERVICE_ACCOUNT_JSON=

# 認証モード: dev = 視点切替あり（開発・デモ用） / locked = 本番（別途ログイン実装が必要）
# 未指定時は NODE_ENV=production なら locked、それ以外は dev
AUTH_MODE=dev

# 「今日」の日付を固定したい場合（デモ用）
# APP_TODAY=2026-09-23
